{
  "name": "ui-lab-registry",
  "version": "0.4.8",
  "description": "Component registry and metadata management for ui-lab-components",
  "keywords": [
    "components",
    "metadata",
    "react",
    "registry",
    "ui-lab"
  ],
  "homepage": "https://github.com/ui-lab-core/ui-lab#readme",
  "bugs": {
    "url": "https://github.com/ui-lab-core/ui-lab/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ui-lab-core/ui-lab"
  },
  "files": [
    "dist",
    "src",
    "scripts"
  ],
  "type": "module",
  "bin": {
    "ui-lab-registry": "./scripts/actions.mjs"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./data": {
      "import": "./dist/.generated/data.js",
      "types": "./dist/.generated/data.d.ts"
    },
    "./artifacts": {
      "import": "./dist/artifacts.js",
      "types": "./dist/artifacts.d.ts"
    },
    "./init-config": {
      "types": "./dist/init-config.d.ts",
      "import": "./dist/init-config.js",
      "default": "./dist/init-config.js"
    },
    "./init-generation/*": {
      "types": "./dist/init-generation/*.d.ts",
      "import": "./dist/init-generation/*.js",
      "default": "./dist/init-generation/*.js"
    },
    "./components": {
      "import": "./dist/components/index.js",
      "types": "./dist/components/index.d.ts"
    },
    "./components/*": {
      "import": "./dist/components/*/index.js",
      "types": "./dist/components/*/index.d.ts"
    },
    "./components/*/examples": {
      "import": "./dist/components/*/examples/index.js",
      "types": "./dist/components/*/examples/index.d.ts"
    },
    "./components/*/examples.json": {
      "import": "./dist/components/*/examples.json"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "pnpm generate && rm -rf dist && tsc",
    "registry": "node scripts/actions.mjs",
    "type-check": "tsc --noEmit",
    "generate": "node --import tsx scripts/generate-registry-data.ts",
    "validate": "node --import tsx scripts/validate-registry.ts",
    "test": "node --import tsx --test src/init-config.test.ts src/artifacts.test.ts src/workshop-content.test.ts scripts/generate-public-artifacts.test.ts scripts/generate-styles-data.test.ts scripts/component-contracts.test.ts"
  },
  "dependencies": {
    "react-icons": "^5.5.0",
    "ui-lab-components": "0.4.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.11",
    "@types/node": "^20",
    "@types/react": "^19",
    "postcss": "^8.5.6",
    "react": "^19",
    "react-docgen-typescript": "^2.2.2",
    "tsx": "^4.7.0",
    "typescript": "^5"
  }
}

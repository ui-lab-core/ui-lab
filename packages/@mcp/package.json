{
  "name": "ui-lab-mcp",
  "version": "0.4.9",
  "description": "MCP server for UI Lab component library - enables AI agents to discover, understand, and generate production-ready code",
  "keywords": [
    "ai",
    "code-generation",
    "components",
    "mcp",
    "model-context-protocol",
    "ui-lab"
  ],
  "license": "MIT",
  "bin": {
    "ui-lab-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "pnpm --filter ui-lab-registry run build && tsc",
    "dev": "tsc --watch",
    "type-check": "tsc --noEmit",
    "start": "node dist/index.js",
    "test": "tsc && node --test dist/*.test.js",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "ui-lab-registry": "workspace:*",
    "@ui-lab-core/library": "link:../../../private/packages/library"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18"
  }
}

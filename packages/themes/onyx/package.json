{
  "name": "ui-lab-theme-onyx",
  "version": "0.4.9",
  "license": "MIT",
  "style": "./dist/styles.css",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/styles.css",
  "exports": {
    ".": {
      "types": "./dist/theme-contract.d.ts",
      "style": "./dist/styles.css",
      "default": "./dist/styles.css"
    },
    "./styles.css": {
      "types": "./dist/theme-contract.d.ts",
      "style": "./dist/styles.css",
      "default": "./dist/styles.css"
    },
    "./theme-contract.json": {
      "default": "./dist/theme-contract.json"
    }
  },
  "scripts": {
    "build": "node --import tsx scripts/build.mts --out dist/styles.css",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm run build"
  },
  "peerDependencies": {
    "ui-lab-components": "0.4.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.11",
    "tailwindcss": "^4.1.18",
    "typescript": "^5"
  }
}

  "files": [
    "dist",
    "src/index.react-server.js",
    "src/index.react-server.d.ts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && pnpm run build:css && pnpm run build:postcss",
    "build:css": "postcss src/styles.css -o dist/base.css && postcss src/typography.css -o dist/typography.css && cat dist/base.css > dist/styles.css && find dist -maxdepth 1 -name '*.css' ! -name base.css ! -name styles.css ! -name typography.css -exec cat {} + >> dist/styles.css",
    "build:postcss": "cp src/postcss-ui-lab.ts dist/postcss-ui-lab.mjs",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest --run",
    "test:coverage": "vitest --coverage"
  },
  "peerDependencies": {

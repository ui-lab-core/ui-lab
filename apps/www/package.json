{
  "name": "@ui-lab/site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prebuild": "([ -d ../../../private ] && pnpm --dir ../../../private --filter @ui-lab-core/library build || true) && pnpm --filter ui-lab-theme-onyx build && pnpm --filter ui-lab-components build && pnpm --filter ui-lab-registry build && npm run prepare:icons",
    "predev": "pnpm --filter ui-lab-theme-onyx build",
    "dev": "npm run prepare:icons && npm run generate:docs && next dev",
    "build": "npm run generate:docs && next build --webpack && npm run verify:component-css",
    "start": "next start",
    "lint": "eslint",
    "type-check": "tsc --noEmit",
    "test:config": "node --import tsx --test 'src/app/(main)/config/config-command.test.ts'",
    "prepare:icons": "node scripts/prepare-icon-assets.mjs",
    "generate:docs": "node --import tsx scripts/generate-docs.mts",
    "verify:private-library": "node --conditions development --import tsx scripts/verify-private-library-link.mts",
    "verify:component-css": "node scripts/verify-component-css.mjs"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.8.3",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@fontsource-variable/work-sans": "^5.2.8",
    "@shikijs/transformers": "^3.20.0",
    "@ui-lab-core/library": "link:../../../private/packages/library",
    "@ui-lab/backend": "workspace:*",
    "beautiful-mermaid": "^1.0.2",
    "clsx": "^2.1.1",
    "convex": "^1.45.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.577.0",
    "next": "16.3.3",
    "next-mdx-remote-client": "^2.1.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-icons": "^5.6.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^3.17.1",
    "turndown": "^7.2.2",
    "ui-lab-components": "workspace:*",
    "ui-lab-registry": "workspace:*",
    "ui-lab-theme-onyx": "workspace:*"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.11",
    "@types/node": "^20",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/turndown": "^5.0.6",
    "eslint": "^9",
    "eslint-config-next": "16.2.0",
    "postcss": "^8.5.6",
    "tsx": "^4.21.0",
    "typescript": "^5"
  },
  "reactDoctor": {
    "ignore": {
      "rules": [
        "react-doctor/nextjs-no-native-script"
      ]
    }
  }
}
